    "/api/runs/{run_id}/games/{game_id}/stream": {
      "get": {
        "description": "Server-Sent Events stream. On connect the server replays any events up to the current tail of the on-disk log, then switches to the live feed. Reconnecting clients SHOULD send `Last-Event-ID: <tick>`; the server will skip any tick id less than or equal to that value. Each `event:`-typed frame carries its tick as the frame's SSE `id`. `heartbeat` frames carry no tick.",
        "parameters": [
          {
            "description": "UUID of the run.",
            "in": "path",
            "name": "run_id",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "Server-assigned game id.",
            "in": "path",
            "name": "game_id",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "Tick id of the last `event`-typed SSE frame the client received. On reconnect the server skips any frame with a tick id <= this value.",
            "in": "header",
            "name": "Last-Event-ID",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "text/event-stream": {
                "schema": {
                  "$ref": "#/components/schemas/SseFrame"
                }
              }
            },
            "description": "Infinite SSE stream of `SseFrame` values. Ends on the first `final` frame."
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "api_version": {
                      "type": "string"
                    },
