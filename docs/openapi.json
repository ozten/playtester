                    "api_version",
                    "errors"
                  ],
                  "type": "object"
                }
              }
            },
            "description": "`run_id` or `game_id` unknown."
          }
        },
        "summary": "Live SSE stream of a game's log."
      }
    },
    "/api/runs/{run_id}/stream": {
      "get": {
        "description": "Server-Sent Events stream. Frames fire when games inside this run start and finish, plus one terminal `run_complete` frame. Clients may reconnect with `Last-Event-ID` but run-level frames are not re-delivered — use the per-game stream for replay semantics.",
