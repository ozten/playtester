    "/api/runs/{run_id}/games/{game_id}/events": {
      "get": {
        "description": "Returns a window of records from the game's JSONL log. Records are returned in on-disk order: header, zero or more events, then a final record (if the game ended cleanly). Use `offset` + `limit` to page forward; the response's `total` field is the current line count of the log.",
        "parameters": [
          {
            "description": "UUID of the run.",
            "in": "path",
            "name": "run_id",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "Server-assigned game id.",
            "in": "path",
            "name": "game_id",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "Zero-based starting offset.",
            "in": "query",
            "name": "offset",
            "required": false,
            "schema": {
              "type": "integer"
            }
          },
          {
            "description": "Max records in the page (1..=10000). Default 100.",
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "api_version": {
                      "type": "string"
                    },
                    "data": {
